# Local development only. Replace this placeholder before starting PostgreSQL.
# No Polymarket credentials, wallet, private key, or model key is needed.
POSTGRES_USER=eventtrader
POSTGRES_DB=eventtrader
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Change both ports to an available local port when 5432 is reserved.
POSTGRES_HOST_PORT=5432
TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false
STARTING_CAPITAL_USD=50
MAX_SINGLE_POSITION_USD=2.50
MAX_TOTAL_EXPOSURE_USD=30
MIN_CASH_RESERVE_USD=20
MAX_DAILY_LOSS_USD=3
MAX_WEEKLY_LOSS_USD=7.50
MAX_DRAWDOWN_PERCENT=20
MAX_SIMULTANEOUS_MARKETS=3
MAX_TRADES_PER_DAY=5
LOG_LEVEL=INFO
PROVIDER_TIMEOUT_SECONDS=10
PROVIDER_MAX_RETRIES=2
PROVIDER_BACKOFF_SECONDS=0.5
PROVIDER_MAX_BACKOFF_SECONDS=10
PROVIDER_PAGE_SIZE=50


# Research is disabled by default. "mock" is deterministic and needs no model key.
# "litellm" reads provider credentials from the process environment; never commit them.
MODEL_MODE=disabled
EXTRACTION_MODEL=
RESEARCH_MODEL=
CRITIC_MODEL=
FALLBACK_MODEL=
EXTRACTION_EXPECTED_COST_USD=0.001
RESEARCH_EXPECTED_COST_USD=0.02
CRITIC_EXPECTED_COST_USD=0.01
RESEARCH_PER_CALL_BUDGET_USD=0.05
RESEARCH_DAILY_BUDGET_USD=0.25
RESEARCH_TIMEOUT_SECONDS=30
RESEARCH_SLIPPAGE_BPS=50
EVIDENCE_MAX_BYTES=200000
EVIDENCE_MAX_AGE_HOURS=168
SNAPSHOT_MAX_AGE_MINUTES=60
RSS_FEED_URLS=
